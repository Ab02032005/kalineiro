# Скопируйте в .env и заполните. Файл .env НЕ попадает в Git.

KALI_ENVIRONMENT=dev
KALI_LOG_LEVEL=INFO
KALI_HOST=127.0.0.1
KALI_PORT=8000

# Ключ провайдера моделей (необязательно на этапе 2)
KALI_PROVIDER_API_KEY=
KALI_PROVIDER_BASE_URL=https://api.chatanywhere.tech/v1
KALI_DEFAULT_MODEL=gpt-4o-mini
